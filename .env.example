# Copy to .env for local development. All settings must have a dev default here (CLAUDE.md §8).
# Never put real secrets in this file — see docs/07_SECURITY_AND_COMPLIANCE.md.

APP_ENV=local
# App runtime connects as the restricted pfa_app role (created by migration 0011) so Postgres RLS
# is actually enforced. Alembic connects as the docker-compose superuser (DDL/role privileges).
DATABASE_URL=postgresql+asyncpg://pfa_app:pfa_app_dev@postgres:5432/pfa
MIGRATION_DATABASE_URL=postgresql+asyncpg://pfa:pfa@postgres:5432/pfa
PFA_APP_DB_PASSWORD=pfa_app_dev
PFA_SUPERADMIN_DB_PASSWORD=pfa_superadmin_dev
REDIS_URL=redis://redis:6379/0

# Key management — local dev only. Production uses KMS_PROVIDER=aws|gcp with a real key.
SECRET_KEY_ID=dev
JWT_PRIVATE_KEY_PATH=./dev-keys/jwt_ed25519
# KMS_PROVIDER: local|aws|gcp
KMS_PROVIDER=local
LOCAL_KEK_BASE64=dev-only-not-a-real-key
PHONE_HASH_PEPPER=dev-only-not-a-real-pepper

# Vendor adapters — default to fakes (docs/08_TESTING_STRATEGY.md §2). Flip to the real
# provider only once credentials exist; see docs/12_OPEN_QUESTIONS.md for what's still pending.
# TELEPHONY_PROVIDER: fake|plivo
TELEPHONY_PROVIDER=fake
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# STT_PROVIDER: fake|deepgram
STT_PROVIDER=fake
DEEPGRAM_API_KEY=
# LLM_PROVIDER: fake|gemini
LLM_PROVIDER=fake
GEMINI_API_KEY=
LLM_MODEL_INCALL=gemini-flash
LLM_MODEL_POSTCALL=gemini-flash
# TTS_PROVIDER: fake|cartesia
TTS_PROVIDER=fake
CARTESIA_API_KEY=

LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

S3_ENDPOINT=http://minio:9000
S3_BUCKET=pfa-audio

EMAIL_PROVIDER=smtp
SMTP_URL=smtp://mailpit:1025

# Comma-separated E.164 numbers. REQUIRED (non-empty) outside production whenever
# TELEPHONY_PROVIDER=plivo — startup refuses to boot otherwise (PFA-SYS-010).
TEST_ALLOWLIST_E164=

PLATFORM_MAX_CONCURRENT_CALLS=50
DND_STRICT=true

# Host port 8010, not 8000 — see infra/docker-compose.yml's api service comment.
PUBLIC_BASE_URL=http://localhost:8010
DASHBOARD_BASE_URL=http://localhost:3000

SENTRY_DSN=
